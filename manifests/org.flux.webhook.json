{
  "formatVersion": 1,
  "id": "org.flux.webhook",
  "name": "Webhook 通知器",
  "description": "将 Flux 核心生成的统一通知内容发送到 HTTP(S) Webhook。",
  "version": "__VERSION__",
  "apiVersion": 1,
  "runtime": {"kind": "process", "entrypoint": "__ENTRYPOINT__"},
  "type": "notification",
  "category": "NOTIFICATION",
  "capabilities": ["notification.send"],
  "configFields": [{
    "key": "payloadFormat",
    "label": "Payload 格式",
    "type": "select",
    "required": true,
    "defaultValue": "FLUX",
    "options": [
      {"value": "FLUX", "label": "Flux 原生"},
      {"value": "EMBY", "label": "Emby 风格"}
    ]
  }],
  "permissions": {"network": ["notification-target"], "filesystem": []},
  "files": []
}
